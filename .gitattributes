# Normalize text files to LF in the repository
* text=auto eol=lf

# MATLAB / scripts / source
*.m text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sbatch text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary/data files
*.mat binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.fig binary
